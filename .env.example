# ═══════════════════════════════════════════════
# TAMAGOSCII - Frontend environment template
# ═══════════════════════════════════════════════
#
# The frontend is static and reads its configuration from
# `config.js` at runtime. This .env.example is only used when
# you wire a build tool (Vite, Webpack, Next.js...) that will
# inject these values into config.js at build time.
#
# If you are deploying the raw static files, just edit
# `config.js` directly — no .env needed on the frontend.
# ═══════════════════════════════════════════════

# XRPL network: 'mainnet' | 'testnet'
VITE_XRPL_NETWORK=mainnet

# Where micro-transactions are sent
VITE_TREASURY_ADDRESS=rYourTreasuryAddressHere0000000000
VITE_DESTINATION_TAG=20260411

# Optional backend URL (leave empty for static-only mode)
VITE_API_BASE_URL=https://api.tamagoscii.app

# Prices in XRP
VITE_PRICE_FEED=0.01
VITE_PRICE_PLAY=0.02
VITE_PRICE_SLEEP=0.01
VITE_PRICE_CLEAN=0.01

# Analytics (optional)
VITE_SENTRY_DSN=
VITE_PLAUSIBLE_DOMAIN=
