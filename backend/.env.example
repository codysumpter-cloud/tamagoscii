# ═══════════════════════════════════════════════
# TAMAGOSCII BACKEND - Environment template
# ═══════════════════════════════════════════════
# Copy this file to `.env` and fill in your values.
# NEVER commit the real `.env` — it's in .gitignore.
# ═══════════════════════════════════════════════

# ───── Runtime ─────
NODE_ENV=production
API_PORT=3000

# ───── XRPL network ─────
# 'mainnet' for production, 'testnet' for free testing.
XRPL_NETWORK=mainnet

# WSS endpoint. Leave commented to use the default for the network:
#   mainnet -> wss://xrplcluster.com
#   testnet -> wss://s.altnet.rippletest.net:51233
# XRPL_WSS_URL=wss://xrplcluster.com

# ───── Treasury (where micro-tx are sent) ─────
# Your XRPL address that must receive all payments.
# ⚠️ Must be the SAME as TREASURY_ADDRESS in frontend config.js.
TREASURY_ADDRESS=rYourTreasuryAddressHere000000000

# Unique tag that identifies your Tamagoscii payments.
# Any positive integer; keep it consistent with the frontend.
DESTINATION_TAG=20260411

# ───── Database ─────
# Path to the SQLite file. Default: ./data/tamagoscii.sqlite
# DB_PATH=/var/data/tamagoscii.sqlite

# ───── CORS ─────
# Comma-separated list of allowed origins, or '*' for public.
CORS_ORIGINS=https://tamagoscii.app,https://www.tamagoscii.app

# ───── Rate limit ─────
RATE_LIMIT_MAX=120
RATE_LIMIT_WINDOW_MS=60000

# ───── Security secrets (if you add auth later) ─────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
# SESSION_SECRET=
# JWT_SECRET=

# ───── Observability (optional) ─────
# SENTRY_DSN=
