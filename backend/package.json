{
  "name": "tamagoscii-backend",
  "version": "1.0.0",
  "description": "Minimal Express backend for Tamagoscii — verifies XRPL micro-transactions and stores creature state.",
  "private": true,
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "migrate": "node -e \"import('./server.js').then(m => console.log('DB initialized'))\""
  },
  "engines": {
    "node": ">=18.17.0"
  },
  "dependencies": {
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "xrpl": "^4.0.0"
  },
  "keywords": [
    "tamagoscii",
    "xrpl",
    "gemwallet",
    "virtual-pet",
    "tamagotchi"
  ],
  "license": "MIT"
}
